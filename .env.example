# Never put real credentials in this file.
DATABASE_URL=
LLM_BASE_URL=https://parley.api.mit.edu/v1
LLM_API_KEY=
# Default MIT Parley model for development and evaluation.
LLM_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=Alibaba-NLP/gte-modernbert-base
MAX_AGENT_ROUNDS=3
MAX_SEARCHES=2
MAX_RETRIEVED_CHUNKS=12
MAX_EVIDENCE_CHARACTERS=36000
MAX_OUTPUT_TOKENS=3000
REQUEST_TIMEOUT_SECONDS=90
APP_DEMO_MODE=false
